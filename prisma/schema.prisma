generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  // Stored lowercased. Uniqueness is enforced here, not only in code.
  email           String    @unique
  name            String
  // bcrypt hash. The plain password is never stored.
  passwordHash    String
  // Null until the emailed code is confirmed.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  sessions           Session[]
  verificationCodes  VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  notes               Note[]
  auditLogs           AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the cookie value. The raw token only ever lives in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the 6-digit code.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  // Wrong guesses against this code. The code dies at the configured maximum.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the token in the emailed link.
  tokenHash String    @unique
  expiresAt DateTime
  // Set once, atomically, when the token is redeemed.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimit {
  // "<action>:<ip or email>"
  key         String   @id
  count       Int
  windowStart DateTime
}

// A record owned by exactly one user.
model Note {
  // Internal primary key. Used for storage and joins only; never sent to a client.
  id        Int      @id @default(autoincrement())
  // The identifier clients see: random, unique, safe to put in a URL.
  // It identifies a note. It does not authorise access to it.
  publicId  String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())

  // Serves the list: WHERE userId = ? ORDER BY createdAt DESC.
  @@index([userId, createdAt])
}

enum AuditAction {
  NOTE_DELETED
}

// What was done, by whom, to what, and when. Rows copy the record's identity,
// so they still say what was deleted after the record itself is gone.
model AuditLog {
  id               Int         @id @default(autoincrement())
  actorUserId      String
  actor            User        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action           AuditAction
  recordPublicId   String
  recordInternalId Int
  recordTitle      String
  createdAt        DateTime    @default(now())

  @@index([actorUserId, createdAt])
}
